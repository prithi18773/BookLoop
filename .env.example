# Copy this file to .env and fill in your own values. Never commit .env to git.

PORT=3000

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/campus-book-exchange
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-book-exchange
MONGO_URI=mongodb://127.0.0.1:27017/campus-book-exchange

# JWT secrets - use long random strings in production
# Generate one quickly with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Hours a reservation stays valid before it auto-expires and moves to the next person in queue
RESERVATION_EXPIRY_HOURS=48

# Cron schedule for checking expired reservations (default: every hour)
CRON_SCHEDULE=0 * * * *
